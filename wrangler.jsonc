{
  "name": "3islyon",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "vars": {
    "RENTMAN_BASE_URL": "https://api.rentman.net"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "REQUESTS_DB",
      "database_name": "3islyon-requests",
      "database_id": "5964f3b7-6cc3-40af-92ce-d74c8e0d2206"
    }
  ]
}
